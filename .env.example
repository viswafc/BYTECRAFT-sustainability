# ---- AquaRisk AI configuration (copy to .env; never commit .env) ----------
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL. Local dev: run `docker compose up db` or your own instance.
DATABASE_URL=postgresql+psycopg://aquarisk:aquarisk@localhost:5432/aquarisk
POSTGRES_USER=aquarisk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aquarisk
# Used by pytest for DB-backed tests (created automatically if the server is reachable)
TEST_DATABASE_URL=postgresql+psycopg://aquarisk:aquarisk@localhost:5432/aquarisk_test

# Telemetry source: database | simulator (Phase 3) | iot (later)
TELEMETRY_PROVIDER=database
WS_HEARTBEAT_SECONDS=5

# ML artifacts + baseline dataset (relative paths resolve from the repo root)
MODEL_PATH=./ml/artifacts
DATASET_PATH=./data/raw/location_aware_gis_leakage_dataset.csv

# Backend CORS allow-list (comma-separated). The frontend proxies /api same-origin, so only
# list origins that call the API directly.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend -> backend. Leave empty to use the same-origin proxy (recommended).
VITE_API_BASE_URL=
# Where the Vite dev server forwards /api (server-side only, never shipped to the browser)
VITE_BACKEND_PROXY=http://localhost:8000

# LLM provider abstraction — backend only, NEVER read by frontend code. Unused until the Copilot phase.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
