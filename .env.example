# ---- AquaRisk AI configuration (copy to .env; never commit .env) ----------
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (optional in Phase 1; the API runs without it)
DATABASE_URL=postgresql+psycopg://aquarisk:aquarisk@localhost:5432/aquarisk
POSTGRES_USER=aquarisk
POSTGRES_PASSWORD=aquarisk
POSTGRES_DB=aquarisk

# ML artifacts + dataset (defaults resolve relative to the repo root)
MODEL_PATH=./ml/artifacts
DATASET_PATH=./data/raw/location_aware_gis_leakage_dataset.csv

# Backend CORS (comma-separated). Frontend dev server proxies /api so "*" is fine locally.
CORS_ORIGINS=*

# Frontend -> backend. Leave empty to use same-origin proxy (recommended).
VITE_API_BASE_URL=
# Where the Vite dev server / nginx forwards /api (server-side only)
VITE_BACKEND_PROXY=http://localhost:8000

# LLM provider abstraction (backend only - NEVER used in frontend code). Unused in Phase 1.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
